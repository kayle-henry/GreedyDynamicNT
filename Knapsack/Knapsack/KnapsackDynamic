	import java.util.concurrent.TimeUnit;

	//bottm-up dynamic programming approach with time limit

	static int knapsackM(int w, int[] val, int[] wt, long limit, TimeUnit unit) {
		long start = System.nanoTime();
		long timeLimit = unit.toNanos(limit);
		int[][] dp = new int[val.length + 1][w + 1];
		int best = 0;

		for (int i = 1; i <= val.length; i++) {
			// Descending order computes dp[i][w] first for this item prefix.
			for (int capacity = w; capacity >= 0; capacity--) {
				if (System.nanoTime() - start >= timeLimit) {
					return best;
				}

				dp[i][capacity] = dp[i - 1][capacity];
				if (wt[i - 1] <= capacity) {
					dp[i][capacity] = Math.max(
						dp[i][capacity],
						val[i - 1] + dp[i - 1][capacity - wt[i - 1]]
					);
				}

				if (capacity == w) {
					best = dp[i][capacity];
				}
			}
		}

		return dp[val.length][w];
	}

