	public static int run(int w, Items[] itemsList, long limit, TimeUnit unit) {
	    long start = System.nanoTime();
	    long timeLimit = unit.toNanos(limit);

	    if (!Quicksort.sortUntil(itemsList, 0, itemsList.length - 1, start, timeLimit)) {
	        return 0;
	    }

	    int sumwt = 0;
	    int totalVal = 0;

	    for (Items item : itemsList) {
	        if (System.nanoTime() - start >= timeLimit) {
	            return totalVal;
	        }

	        if (item.weight + sumwt <= w) {
	            sumwt += item.weight;
	            totalVal += item.value;
	        }
	    }

	    return totalVal;
	}

